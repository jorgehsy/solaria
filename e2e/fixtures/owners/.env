# Fake tokens for the fake GitHub in e2e/fake-github.ts. Not secrets.
# acme has no owner token, so it uses the main one; globex and umbrella use their own.
# umbrella's own token is wrong: it must show bad_token, never fall back to the main token.
GITHUB_TOKEN=main-token
GITHUB_TOKEN_GLOBEX=globex-token
GITHUB_TOKEN_UMBRELLA=wrong-token
GITHUB_API_URL=http://127.0.0.1:4790
SOLARIA_POLL_MS=1000
