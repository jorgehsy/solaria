# Your GitHub token. Fine-grained and read-only is enough: Issues read + Pull requests read
# (Metadata read is implicit). Public repos need no permissions. A classic token with the
# `repo` scope also works for private repos, but it can write, so prefer fine-grained.
GITHUB_TOKEN=github_pat_xxxxxxxx

# Optional: one token per owner. Owner in capitals, `-` as `_` (my-org -> GITHUB_TOKEN_MY_ORG).
# It wins over GITHUB_TOKEN for that owner's repos. There is no fallback if it fails.
# GITHUB_TOKEN_MY_ORG=github_pat_xxxxxxxx
